# Local demonstration only. Replace before use outside a disposable local environment.
DB_PASSWORD=taskflow-local-demo-only
# Host PostgreSQL port. Set another value if a local database already uses 5432.
DB_PORT=5432
# Required: replace with the single-line output of openssl rand -base64 32.
# The decoded key must contain at least 32 random bytes. Never commit the real key.
JWT_SECRET=
